#include <stdio.h>

// Funciones
int leer_numero(char* mensaje);
int perfecto(int numero);
void imprimir_factores(int numero);

int leer_numero(char* mensaje) {
    int numero;
    printf("%s", mensaje);
    scanf("%d", &numero);
    return numero;
}

// Función que determina si un número es perfecto
int perfecto(int numero) {
    int suma = 0;
    for (int i = 1; i < numero; i++) {
        if (numero % i == 0) {
            suma += i;
        }
    }
    return (suma == numero);
}

// Función para imprimir los factores de un número
void imprimir_factores(int numero) {
    printf("Factores de %d: ", numero);
    for (int i = 1; i < numero; i++) {
        if (numero % i == 0) {
            printf("%d ", i);
        }
    }
    printf("\n");
}

int main() {
    int numero = leer_numero("Introduce un número: ");

    if (perfecto(numero)) {
        printf("%d es un número perfecto.\n", numero);
        imprimir_factores(numero);
    } else {
        printf("%d NO es un número perfecto.\n", numero);
    }

    return 0;
}
