#include <stdio.h>
#define ANIO 2
#define MES 3

int main() {
    float lluvia[ANIO][MES];
    float suma;
    float promedioAnio[ANIO];
    float sumaMes[MES] = {0};
    int anioMayor = 0, anioMenor = 0;
    int mesMayor = 0, mesMenor = 0;

    // Ingreso de datos
    for (int i = 0; i < ANIO; i++) {
        for (int j = 0; j < MES; j++) {
            printf("Ingrese el promedio de lluvia del mes %d del anio %d: ", j + 1, i + 1);
            scanf("%f", &lluvia[i][j]);
        }
        printf("\n");
    }

    // Imprimir datos
    printf("Datos historicos de lluvia mensual en los ultimos %d anios:\n", ANIO);
    for (int i = 0; i < ANIO; i++) {
        for (int j = 0; j < MES; j++) {
            printf("%.2f\t", lluvia[i][j]);
        }
        printf("\n");
    }

    // Promedio de lluvia por año
    for (int i = 0; i < ANIO; i++) {
        suma = 0;
        for (int j = 0; j < MES; j++) {
            suma += lluvia[i][j];
        }
        promedioAnio[i] = suma / MES;
    }

    // Mostrar promedios de año y buscar el mayor/menor
    for (int i = 0; i < ANIO; i++) {
        printf("El promedio de lluvia del anio %d es %.2f\n", i + 1, promedioAnio[i]);
        if (promedioAnio[i] > promedioAnio[anioMayor]) {
            anioMayor = i;
        }
        if (promedioAnio[i] < promedioAnio[anioMenor]) {
            anioMenor = i;
        }
    }

    printf("\nEl anio con MAS lluvia fue el anio %d con un promedio de %.2f\n", anioMayor + 1, promedioAnio[anioMayor]);
    printf("El anio con MENOS lluvia fue el anio %d con un promedio de %.2f\n", anioMenor + 1, promedioAnio[anioMenor]);

    // Calcular total por mes
    for (int j = 0; j < MES; j++) {
        for (int i = 0; i < ANIO; i++) {
            sumaMes[j] += lluvia[i][j];
        }
    }

    // Buscar el mes con más y menos lluvia
    for (int j = 1; j < MES; j++) {
        if (sumaMes[j] > sumaMes[mesMayor]) {
            mesMayor = j;
        }
        if (sumaMes[j] < sumaMes[mesMenor]) {
            mesMenor = j;
        }
    }

    printf("\nEl MES con MAS lluvia fue el mes %d con un total de %.2f\n", mesMayor + 1, sumaMes[mesMayor]);
    printf("El MES con MENOS lluvia fue el mes %d con un total de %.2f\n", mesMenor + 1, sumaMes[mesMenor]);

    return 0;
}
